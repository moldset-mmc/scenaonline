{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "checkpoint/scena-hosting-2026-09-14": false
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "scenaonline.vercel.app" }],
      "destination": "https://scena.life/:path*",
      "permanent": true
    }
  ]
}
